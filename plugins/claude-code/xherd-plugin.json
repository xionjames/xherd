{
  "name": "claude-code",
  "kind": "runtime",
  "version": "0.1.0",
  "label": "Claude Code",
  "description": "The Claude Code CLI in a tmux session (terminal driver).",
  "data": {
    "terminal": {
      "launch": [
        "claude"
      ],
      "permissionModes": {
        "ask": [
          "--permission-mode",
          "manual"
        ],
        "edits": [
          "--permission-mode",
          "acceptEdits"
        ],
        "auto": [
          "--permission-mode",
          "auto"
        ],
        "all": [
          "--permission-mode",
          "bypassPermissions"
        ]
      },
      "skills": {
        "dir": ".claude/skills",
        "format": "skill"
      },
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "models": [
        {
          "id": "opus",
          "label": "Opus (latest)",
          "tier": "strong"
        },
        {
          "id": "sonnet",
          "label": "Sonnet (latest)",
          "tier": "balanced"
        },
        {
          "id": "haiku",
          "label": "Haiku (latest)",
          "tier": "fast"
        }
      ],
      "hooks": {
        "file": ".claude/settings.local.json",
        "events": {
          "SessionStart": "session-start",
          "UserPromptSubmit": "user-prompt-submit",
          "PostToolUse": "post-tool-use",
          "Notification": "notification",
          "Stop": "stop"
        }
      },
      "trust": {
        "file": "${CLAUDE_CONFIG_DIR:-~}/.claude.json",
        "projects": "projects",
        "key": "hasTrustDialogAccepted"
      },
      "resume": {
        "args": [
          "--resume",
          "{session}"
        ],
        "transcripts": "${CLAUDE_CONFIG_DIR:-~/.claude}/projects",
        "file": "{session}.jsonl"
      },
      "check": {
        "argv": [
          "claude",
          "-p",
          "{prompt}",
          "--append-system-prompt",
          "{system}",
          "--no-session-persistence",
          "--allowedTools",
          "Read",
          "Grep",
          "Glob",
          "WebFetch",
          "Bash(gh pr view:*)",
          "Bash(gh pr checks:*)",
          "Bash(gh pr list:*)",
          "Bash(gh pr status:*)",
          "Bash(gh pr diff:*)",
          "Bash(gh search:*)",
          "Bash(gh issue list:*)",
          "Bash(gh issue status:*)",
          "Bash(gh run list:*)",
          "Bash(gh run view:*)",
          "Bash(gh repo view:*)",
          "Bash(gh release list:*)",
          "Bash(gh release view:*)",
          "Bash(gh issue view:*)",
          "Bash(git log:*)",
          "Bash(git status:*)",
          "Bash(git diff:*)",
          "Bash(git show:*)",
          "--disallowedTools",
          "Edit",
          "Write",
          "NotebookEdit"
        ],
        "modelArgs": [
          "--model",
          "{model}"
        ]
      },
      "usage": {
        "records": "/message/usage",
        "id": "/message/id",
        "fields": {
          "input": "input_tokens",
          "output": "output_tokens",
          "cacheWrite": "cache_creation_input_tokens",
          "cacheRead": "cache_read_input_tokens"
        }
      }
    }
  },
  "requires": [
    {
      "name": "claude",
      "check": [
        "claude",
        "--version"
      ],
      "version": "2.1.319",
      "sha256": {
        "x86_64": "dabafec82ca1319fa43d8be36a10fc61b1d11821cb98ad5df04ad95e199b8eed",
        "aarch64": "a7e687fd1cb054d651c7588223de3786c99d4c682365e3c3ae1e59ce7f3a591f"
      },
      "install": [
        "sh",
        "-c",
        "set -eu\nd=$(mkdir -p \"$HOME/.cache\" && mktemp -d \"$HOME/.cache/xherd-install.XXXXXX\")\ntrap 'rm -rf \"$d\"' EXIT\ncase \"$XHERD_INSTALL_ARCH\" in x86_64) a=x64;; aarch64) a=arm64;; *) echo \"unsupported: $XHERD_INSTALL_ARCH\" >&2; exit 1;; esac\ncurl -fsSL --retry 3 -o \"$d/pkg\" \"https://downloads.claude.ai/claude-code-releases/$XHERD_INSTALL_VERSION/linux-$a/claude\"\necho \"$XHERD_INSTALL_SHA256  $d/pkg\" | sha256sum -c -\nchmod +x \"$d/pkg\"\n\"$d/pkg\" install \"$XHERD_INSTALL_VERSION\"\n"
      ],
      "instructions": {
        "any": "npm install -g @anthropic-ai/claude-code   # or see https://docs.claude.com/en/docs/claude-code/setup"
      }
    }
  ],
  "checks": [
    {
      "name": "login",
      "argv": [
        "claude",
        "auth",
        "status"
      ]
    }
  ],
  "login": [
    "claude",
    "auth",
    "login"
  ]
}
