{
  "name": "claude-code",
  "kind": "runtime",
  "version": "0.1.0",
  "label": "Claude Code",
  "description": "The Claude Code CLI in a tmux session (terminal driver).",
  "data": {
    "terminal": {
      "launch": [
        "claude"
      ],
      "permissionModes": {
        "ask": [
          "--permission-mode",
          "manual"
        ],
        "edits": [
          "--permission-mode",
          "acceptEdits"
        ],
        "auto": [
          "--permission-mode",
          "auto"
        ],
        "all": [
          "--permission-mode",
          "bypassPermissions"
        ]
      },
      "hooks": {
        "file": ".claude/settings.local.json",
        "events": {
          "SessionStart": "session-start",
          "UserPromptSubmit": "user-prompt-submit",
          "PostToolUse": "post-tool-use",
          "Notification": "notification",
          "Stop": "stop"
        }
      },
      "trust": {
        "file": "${CLAUDE_CONFIG_DIR:-~}/.claude.json",
        "projects": "projects",
        "key": "hasTrustDialogAccepted"
      },
      "resume": {
        "args": [
          "--resume",
          "{session}"
        ],
        "transcripts": "${CLAUDE_CONFIG_DIR:-~/.claude}/projects",
        "file": "{session}.jsonl"
      },
      "check": {
        "argv": [
          "claude",
          "-p",
          "{prompt}",
          "--append-system-prompt",
          "{system}",
          "--no-session-persistence",
          "--allowedTools",
          "Read",
          "Grep",
          "Glob",
          "WebFetch",
          "Bash(gh pr view:*)",
          "Bash(gh pr checks:*)",
          "Bash(gh pr list:*)",
          "Bash(gh pr status:*)",
          "Bash(gh pr diff:*)",
          "Bash(gh search:*)",
          "Bash(gh issue list:*)",
          "Bash(gh issue status:*)",
          "Bash(gh run list:*)",
          "Bash(gh run view:*)",
          "Bash(gh repo view:*)",
          "Bash(gh release list:*)",
          "Bash(gh release view:*)",
          "Bash(gh issue view:*)",
          "Bash(git log:*)",
          "Bash(git status:*)",
          "Bash(git diff:*)",
          "Bash(git show:*)",
          "--disallowedTools",
          "Edit",
          "Write",
          "NotebookEdit"
        ],
        "modelArgs": [
          "--model",
          "{model}"
        ]
      },
      "usage": {
        "records": "/message/usage",
        "id": "/message/id",
        "fields": {
          "input": "input_tokens",
          "output": "output_tokens",
          "cacheWrite": "cache_creation_input_tokens",
          "cacheRead": "cache_read_input_tokens"
        }
      }
    }
  },
  "requires": [
    {
      "name": "claude",
      "check": [
        "claude",
        "--version"
      ],
      "install": [
        "sh",
        "-c",
        "npm install -g --prefix \"$HOME/.local\" @anthropic-ai/claude-code@2.1.319"
      ],
      "instructions": {
        "any": "npm install -g @anthropic-ai/claude-code   # or see https://docs.claude.com/en/docs/claude-code/setup"
      }
    }
  ],
  "checks": [
    {
      "name": "login",
      "argv": [
        "claude",
        "auth",
        "status"
      ]
    }
  ],
  "login": [
    "claude",
    "auth",
    "login"
  ]
}
