{
  "name": "claude-code",
  "kind": "runtime",
  "version": "0.1.0",
  "label": "Claude Code",
  "description": "The Claude Code CLI in a tmux session (terminal driver).",
  "data": {
    "terminal": {
      "launch": [
        "claude"
      ],
      "permissionModes": {
        "ask": [
          "--permission-mode",
          "manual"
        ],
        "edits": [
          "--permission-mode",
          "acceptEdits"
        ],
        "auto": [
          "--permission-mode",
          "auto"
        ],
        "all": [
          "--permission-mode",
          "bypassPermissions"
        ]
      },
      "hooks": {
        "file": ".claude/settings.local.json",
        "events": {
          "SessionStart": "session-start",
          "UserPromptSubmit": "user-prompt-submit",
          "PostToolUse": "post-tool-use",
          "Notification": "notification",
          "Stop": "stop"
        }
      },
      "trust": {
        "file": "${CLAUDE_CONFIG_DIR:-~}/.claude.json",
        "projects": "projects",
        "key": "hasTrustDialogAccepted"
      },
      "resume": {
        "args": [
          "--resume",
          "{session}"
        ],
        "transcripts": "${CLAUDE_CONFIG_DIR:-~/.claude}/projects",
        "file": "{session}.jsonl"
      }
    }
  },
  "checks": [
    {
      "name": "claude",
      "argv": [
        "claude",
        "--version"
      ]
    },
    {
      "name": "login",
      "argv": [
        "claude",
        "auth",
        "status"
      ]
    }
  ],
  "login": [
    "claude",
    "auth",
    "login"
  ]
}
