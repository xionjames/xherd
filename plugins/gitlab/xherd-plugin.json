{
  "name": "gitlab",
  "kind": "host",
  "version": "0.1.0",
  "label": "GitLab",
  "description": "GitLab merge requests and git access through the glab CLI.",
  "settings": [
    { "key": "glab", "label": "glab binary", "default": "glab" },
    { "key": "token", "label": "Token (GITLAB_TOKEN; empty = glab's own login)", "secret": true }
  ],
  "timeoutSeconds": 30,
  "requires": [
    {
      "name": "glab",
      "check": [
        "glab",
        "--version"
      ],
      "optional": true,
      "instructions": {
        "macos": "brew install glab",
        "linux": "See https://gitlab.com/gitlab-org/cli#installation (apt, dnf, or a release download)",
        "any": "See https://gitlab.com/gitlab-org/cli#installation"
      }
    }
  ],
  "data": {
    "git": {
      "hosts": [
        "*gitlab*"
      ],
      "credential": {
        "helper": "!glab auth git-credential",
        "tokenUser": "oauth2"
      },
      "login": [
        "glab",
        "auth",
        "login",
        "--hostname",
        "{host}"
      ],
      "api": {
        "base": "https://{host}/api/v4",
        "user": {
          "path": "/user"
        }
      }
    }
  }
}
