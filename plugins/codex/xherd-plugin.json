{
  "name": "codex",
  "kind": "runtime",
  "version": "0.1.0",
  "label": "Codex",
  "description": "The OpenAI Codex CLI in a tmux session (terminal driver).",
  "data": {
    "terminal": {
      "launch": [
        "codex",
        "--dangerously-bypass-hook-trust"
      ],
      "permissionModes": {
        "ask": [
          "--sandbox",
          "read-only",
          "--ask-for-approval",
          "on-request"
        ],
        "edits": [
          "--sandbox",
          "workspace-write",
          "--ask-for-approval",
          "on-request",
          "-c",
          "sandbox_workspace_write.network_access=true"
        ],
        "auto": [
          "--approve-for-me",
          "-c",
          "sandbox_workspace_write.network_access=true"
        ],
        "all": [
          "--dangerously-bypass-approvals-and-sandbox"
        ]
      },
      "skills": {
        "dir": ".agents/skills",
        "format": "skill"
      },
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "models": {
        "command": "codex debug models | jq -r '.models[] | select(.visibility != \"hide\") | [.slug, .display_name] | @tsv'"
      },
      "hooks": {
        "file": ".codex/hooks.json",
        "format": "codex-hooks",
        "events": {
          "SessionStart": "session-start",
          "UserPromptSubmit": "user-prompt-submit",
          "PostToolUse": "post-tool-use",
          "PermissionRequest": "notification",
          "Stop": "stop"
        }
      },
      "trust": {
        "file": "${CODEX_HOME:-~/.codex}/config.toml",
        "format": "toml",
        "projects": "projects",
        "key": "trust_level",
        "value": "trusted"
      },
      "promptArgs": [
        "{prompt}"
      ],
      "resume": {
        "args": [
          "resume",
          "{session}"
        ],
        "promptArgs": [
          "{prompt}"
        ],
        "transcripts": "${CODEX_HOME:-~/.codex}/sessions",
        "file": "rollout-*-{session}.jsonl",
        "depth": 3
      },
      "check": {
        "argv": [
          "codex",
          "exec",
          "--sandbox",
          "read-only",
          "--ephemeral",
          "--skip-git-repo-check",
          "{system}\n\n{prompt}"
        ],
        "modelArgs": [
          "--model",
          "{model}"
        ]
      },
      "usage": {
        "records": "/payload/usage",
        "id": "/payload/response_id",
        "fields": {
          "input": "input_tokens",
          "output": "output_tokens",
          "cacheWrite": "cache_write_input_tokens",
          "cacheRead": "cached_input_tokens"
        }
      }
    }
  },
  "requires": [
    {
      "name": "codex",
      "check": [
        "codex",
        "--version"
      ],
      "version": "0.167.2",
      "sha256": {
        "x86_64": "8246e846c550ea21197fcc4067bc270dca895e94ea42ed6a282e6f4e0125b15f",
        "aarch64": "ed81fa2c7d209689af061b6f305ed554218de92a1c2c4019142b28f66fa64add"
      },
      "install": [
        "sh",
        "-c",
        "set -eu\nd=$(mkdir -p \"$HOME/.cache\" && mktemp -d \"$HOME/.cache/xherd-install.XXXXXX\")\ntrap 'rm -rf \"$d\"' EXIT\ncase \"$XHERD_INSTALL_ARCH\" in x86_64) a=x86_64;; aarch64) a=aarch64;; *) echo \"unsupported: $XHERD_INSTALL_ARCH\" >&2; exit 1;; esac\ncurl -fsSL --retry 3 -o \"$d/pkg\" \"https://github.com/openai/codex/releases/download/rust-v$XHERD_INSTALL_VERSION/codex-$a-unknown-linux-musl.tar.gz\"\necho \"$XHERD_INSTALL_SHA256  $d/pkg\" | sha256sum -c -\ntar -xzf \"$d/pkg\" -C \"$d\" \"codex-$a-unknown-linux-musl\"\nmkdir -p \"$HOME/.local/bin\"\ninstall -m 0755 \"$d/codex-$a-unknown-linux-musl\" \"$HOME/.local/bin/codex\"\n"
      ],
      "instructions": {
        "any": "npm install -g @openai/codex   # or see https://github.com/openai/codex"
      }
    }
  ],
  "checks": [
    {
      "name": "login",
      "argv": [
        "codex",
        "login",
        "status"
      ]
    }
  ],
  "login": [
    "codex",
    "login",
    "--device-auth"
  ]
}
