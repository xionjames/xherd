{
  "name": "uv",
  "kind": "toolchain",
  "version": "0.1.0",
  "label": "uv",
  "description": "Python versions from .python-version or pyproject.toml (requires-python).",
  "data": {
    "toolchain": {
      "passEnv": [
        "UV_PYTHON_INSTALL_DIR"
      ],
      "tools": [
        {
          "name": "python",
          "files": [
            {
              "path": ".python-version",
              "format": "plain"
            },
            {
              "path": "pyproject.toml",
              "format": "pyproject"
            }
          ],
          "resolve": [
            "sh",
            "-c",
            "p=$(uv python find --no-project \"$1\" 2>/dev/null) && dirname \"$p\"",
            "_",
            "{v}"
          ],
          "install": [
            "uv",
            "python",
            "install",
            "{v}"
          ],
          "list": [
            "sh",
            "-c",
            "uv python list --only-downloads </dev/null | sed -nE 's/^cpython-([0-9]+\\.[0-9]+\\.[0-9]+)-.*/\\1/p' | sort -ruV"
          ]
        }
      ]
    }
  },
  "checks": [
    {
      "name": "uv",
      "argv": [
        "sh",
        "-c",
        "if command -v uv >/dev/null 2>&1; then exit 0; fi; echo \"uv not found (install it: https://docs.astral.sh/uv/)\" >&2; exit 1"
      ],
      "optional": true
    }
  ]
}
